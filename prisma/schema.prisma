// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// -------------------------------------------------
// 1. RBAC (Security & Multi-Persona Authorization)
// -------------------------------------------------
model Role {
  id    Int    @id @default(autoincrement())
  name  String // "Admin", "Manager", "Purchasing", "Staff Gudang"
  
  users User[]
}

model User {
  id       Int    @id @default(autoincrement())
  roleId   Int
  username String @unique
  email    String @unique
  password String @default("")

  role     Role   @relation(fields: [roleId], references: [id])

  // Relations
  createdPos    PurchaseOrder[] @relation("PoCreator")
  approvedPos   PurchaseOrder[] @relation("PoApprover")
  createdSos    SalesOrder[]    @relation("SoCreator")
  dispatchedDos DeliveryOrder[] @relation("DoDispatcher")
  
  transactions Transaction[]
}

// -------------------------------------------------
// 2. Enterprise Master Data
// -------------------------------------------------
model Supplier {
  id           Int       @id @default(autoincrement())
  name         String
  contactInfo  String?
  address      String?
  deletedAt    DateTime? // Soft Delete

  purchaseOrders PurchaseOrder[]
}

model Customer {
  id          Int       @id @default(autoincrement())
  code        String    @unique // e.g. CUST-GLB-001
  name        String
  contactInfo String?
  address     String?
  deletedAt   DateTime? // Soft Delete

  salesOrders SalesOrder[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique // e.g. SKU-ELEC-SRV-90
  barcode     String?   @unique // Global Trade Item Number (GTIN / EAN-13 / UPC)
  name        String
  category    String?   // Enterprise Category e.g. "Computing & Infrastructure", "Industrial Automation"
  uom         String    // unit, pcs, box, pallet, kit
  basePrice   Decimal   @db.Decimal(10, 2)
  minStock    Int       @default(10) // Threshold for automated replenishment
  weightKg    Decimal?  @db.Decimal(8, 2) // Weight per unit in kg
  storageTemp String?   // "Ambient", "-20°C Cold-Chain", "Hazmat / Secure"
  deletedAt   DateTime? // Soft Delete

  inventories        Inventory[]
  poItems            PoItem[]
  soItems            SoItem[]
  deliveryOrderItems DeliveryOrderItem[]
  transactionItems   TransactionItem[]
}

model Warehouse {
  id       Int     @id @default(autoincrement())
  code     String? @unique // Facility Code e.g. "GLOBAL-DC-01", "APAC-HUB-02"
  name     String
  location String
  zoneType String? // e.g. "General High-Bay", "Air Logistics Gateway", "Cold-Chain & Pharma"

  inventories      Inventory[]
  salesOrders      SalesOrder[]
  deliveryOrders   DeliveryOrder[]
  transactionItems TransactionItem[]
}

// -------------------------------------------------
// 3. Core Multi-Location Inventory Ledger
// -------------------------------------------------
model Inventory {
  id              Int       @id @default(autoincrement())
  productId       Int
  warehouseId     Int
  currentQty      Int       @default(0) // On-hand available quantity
  storageLocation String?   // Granular Bin Location e.g. "BLK-A01-R02-B04", "PCK-B02-R01-B03"
  batchNumber     String?   // Traceability Lot / Batch Code e.g. "LOT-2026-X88"
  expiryDate      DateTime? // FEFO Expiration Date for cold-chain / consumables

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  // Prevent duplicate product records per warehouse facility
  @@unique([productId, warehouseId]) 
}

// -------------------------------------------------
// 4. Inbound Procurement & ASN Goods Receipt (PO)
// -------------------------------------------------
model PurchaseOrder {
  id               Int      @id @default(autoincrement())
  supplierId       Int
  createdByUserId  Int      // Purchasing Specialist
  approvedByUserId Int?     // Operations Director / Manager
  status           String   @default("Draft") // Draft, Pending, Approved, Rejected, Completed
  createdAt        DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  createdBy  User     @relation("PoCreator", fields: [createdByUserId], references: [id])
  approvedBy User?    @relation("PoApprover", fields: [approvedByUserId], references: [id])
  
  poItems    PoItem[]
}

model PoItem {
  id            Int     @id @default(autoincrement())
  poId          Int
  productId     Int
  qty           Int     // Ordered Quantity
  receivedQty   Int     @default(0) // Fulfilled / Received Quantity
  expectedPrice Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

// -------------------------------------------------
// 5. Outbound Order Fulfillment (SO & Delivery Order)
// -------------------------------------------------
model SalesOrder {
  id               Int       @id @default(autoincrement())
  soNumber         String    @unique // e.g. SO-2026-0001
  customerId       Int
  warehouseId      Int       // Origin Warehouse Facility
  createdByUserId  Int
  status           String    @default("PENDING") // PENDING, CONFIRMED, PICKING, PACKED, SHIPPED, CANCELLED
  orderDate        DateTime  @default(now())
  deliveryDate     DateTime?
  shippingAddress  String?
  totalAmount      Decimal   @default(0) @db.Decimal(12, 2)
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy      User            @relation("SoCreator", fields: [createdByUserId], references: [id])
  soItems        SoItem[]
  deliveryOrders DeliveryOrder[]
}

model SoItem {
  id         Int     @id @default(autoincrement())
  soId       Int
  productId  Int
  qty        Int     // Requested Quantity
  pickedQty  Int     @default(0) // Wave-picked from storage bins
  packedQty  Int     @default(0) // Verified & packed into containers
  shippedQty Int     @default(0) // Loaded on dispatch vehicle
  unitPrice  Decimal @db.Decimal(10, 2)

  salesOrder SalesOrder @relation(fields: [soId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model DeliveryOrder {
  id             Int       @id @default(autoincrement())
  doNumber       String    @unique // e.g. DO-2026-0001 (Bill of Lading / Dispatch Slip)
  salesOrderId   Int
  warehouseId    Int
  dispatchedById Int
  status         String    @default("SHIPPED") // SHIPPED, DELIVERED
  driverName     String?
  vehiclePlate   String?
  recipientName  String?
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?
  note           String?

  salesOrder   SalesOrder          @relation(fields: [salesOrderId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  dispatchedBy User                @relation("DoDispatcher", fields: [dispatchedById], references: [id])
  doItems      DeliveryOrderItem[]
}

model DeliveryOrderItem {
  id              Int @id @default(autoincrement())
  deliveryOrderId Int
  productId       Int
  qty             Int // Dispatched quantity on this delivery docket

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

// -------------------------------------------------
// 6. Enterprise Audit Trail & Movement Ledger
// -------------------------------------------------
model Transaction {
  id              Int      @id @default(autoincrement())
  type            String   // "IN", "OUT", "TRANSFER", "ADJUST"
  referenceType   String?  // "PO", "DELIVERY_ORDER", "TRANSFER", "OPNAME", "MANUAL"
  referenceId     Int?     // Reference ID
  createdByUserId Int
  timestamp       DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id])

  transactionItems TransactionItem[]
}

model TransactionItem {
  id            Int @id @default(autoincrement())
  transactionId Int
  productId     Int
  warehouseId   Int
  qtyChange     Int // (+) for IN/Positive adjustment, (-) for OUT/Negative adjustment

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
}

// -------------------------------------------------
// 7. Dual-Track Telemetry (High-Speed UDP Aggregator)
// -------------------------------------------------
model TelemetryLog {
  id         Int      @id @default(autoincrement())
  seqId      Int
  level      String   @default("INFO")
  method     String?
  endpoint   String?
  statusCode Int?
  latencyMs  Float?
  userId     Int?
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([endpoint])
  @@index([seqId])
}
