// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


// -------------------------------------------------
// 1. RBAC (Keamanan & Otorisasi)
// -------------------------------------------------
model Role {
  id    Int    @id @default(autoincrement())
  name  String // "Admin", "Staff Gudang", "Purchasing", "Manager"
  
  users User[]
}

model User {
  id       Int    @id @default(autoincrement())
  roleId   Int
  username String @unique
  email    String @unique
  password String @default("")

  role     Role   @relation(fields: [roleId], references: [id])

  // Relasi khusus karena 1 User bisa bikin banyak PO, dan 1 Manager bisa approve banyak PO
  createdPos  PurchaseOrder[] @relation("PoCreator")
  approvedPos PurchaseOrder[] @relation("PoApprover")
  createdSos  SalesOrder[]    @relation("SoCreator")
  dispatchedDos DeliveryOrder[] @relation("DoDispatcher")
  
  transactions Transaction[]
}

// -------------------------------------------------
// 2. Master Data
// -------------------------------------------------
model Supplier {
  id           Int       @id @default(autoincrement())
  name         String
  contactInfo  String?
  address      String?
  deletedAt    DateTime? // Soft Delete

  purchaseOrders PurchaseOrder[]
}

model Customer {
  id          Int       @id @default(autoincrement())
  code        String    @unique // e.g. CUST-001
  name        String
  contactInfo String?
  address     String?
  deletedAt   DateTime? // Soft Delete

  salesOrders SalesOrder[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique
  name        String
  uom         String    // pcs, kg, box
  basePrice   Decimal   @db.Decimal(10, 2)
  minStock    Int       @default(10) // Ambang batas minimum stok untuk alert
  deletedAt   DateTime? // Soft Delete

  inventories        Inventory[]
  poItems            PoItem[]
  soItems            SoItem[]
  deliveryOrderItems DeliveryOrderItem[]
  transactionItems   TransactionItem[]
}

model Warehouse {
  id       Int    @id @default(autoincrement())
  name     String
  location String

  inventories      Inventory[]
  salesOrders      SalesOrder[]
  deliveryOrders   DeliveryOrder[]
  transactionItems TransactionItem[]
}

// -------------------------------------------------
// 3. Core Inventory (Stok Saat Ini)
// -------------------------------------------------
model Inventory {
  id          Int @id @default(autoincrement())
  productId   Int
  warehouseId Int
  currentQty  Int @default(0) // Qty = Jumlah barang

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  // Memastikan tidak ada duplikat data produk yang sama di gudang yang sama
  @@unique([productId, warehouseId]) 
}

// -------------------------------------------------
// 4. Procurement (Inbound Pembelian)
// -------------------------------------------------
model PurchaseOrder {
  id               Int      @id @default(autoincrement())
  supplierId       Int
  createdByUserId  Int      // Staff Purchasing
  approvedByUserId Int?     // Manager (Bisa null kalau belum di-approve)
  status           String   @default("Draft") // Draft, Pending, Approved, Rejected, Completed
  createdAt        DateTime @default(now())

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  createdBy  User     @relation("PoCreator", fields: [createdByUserId], references: [id])
  approvedBy User?    @relation("PoApprover", fields: [approvedByUserId], references: [id])
  
  poItems    PoItem[]
}

model PoItem {
  id            Int     @id @default(autoincrement())
  poId          Int
  productId     Int
  qty           Int     // Jumlah yang dipesan
  receivedQty   Int     @default(0) // Jumlah yang sudah datang (Partial Fulfillment)
  expectedPrice Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

// -------------------------------------------------
// 5. Outbound (Sales Order & Fulfillment Pengiriman)
// -------------------------------------------------
model SalesOrder {
  id               Int       @id @default(autoincrement())
  soNumber         String    @unique // e.g. SO-2026-0001
  customerId       Int
  warehouseId      Int       // Gudang asal pengambilan barang
  createdByUserId  Int
  status           String    @default("PENDING") // PENDING, CONFIRMED, PICKING, PACKED, SHIPPED, CANCELLED
  orderDate        DateTime  @default(now())
  deliveryDate     DateTime?
  shippingAddress  String?
  totalAmount      Decimal   @default(0) @db.Decimal(12, 2)
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy      User            @relation("SoCreator", fields: [createdByUserId], references: [id])
  soItems        SoItem[]
  deliveryOrders DeliveryOrder[]
}

model SoItem {
  id         Int     @id @default(autoincrement())
  soId       Int
  productId  Int
  qty        Int     // Jumlah yang dipesan customer
  pickedQty  Int     @default(0) // Jumlah yang sudah di-pick dari rak
  packedQty  Int     @default(0) // Jumlah yang sudah dikemas
  shippedQty Int     @default(0) // Jumlah yang sudah diberangkatkan
  unitPrice  Decimal @db.Decimal(10, 2)

  salesOrder SalesOrder @relation(fields: [soId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model DeliveryOrder {
  id             Int       @id @default(autoincrement())
  doNumber       String    @unique // e.g. DO-2026-0001 (No. Surat Jalan)
  salesOrderId   Int
  warehouseId    Int
  dispatchedById Int
  status         String    @default("SHIPPED") // SHIPPED, DELIVERED
  driverName     String?
  vehiclePlate   String?
  recipientName  String?
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?
  note           String?

  salesOrder   SalesOrder          @relation(fields: [salesOrderId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  dispatchedBy User                @relation("DoDispatcher", fields: [dispatchedById], references: [id])
  doItems      DeliveryOrderItem[]
}

model DeliveryOrderItem {
  id              Int @id @default(autoincrement())
  deliveryOrderId Int
  productId       Int
  qty             Int // Jumlah barang yang keluar di surat jalan ini

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

// -------------------------------------------------
// 6. Audit Trail & Transaksi (The Ledger / Riwayat Mutasi)
// -------------------------------------------------
model Transaction {
  id              Int      @id @default(autoincrement())
  type            String   // "IN", "OUT", "TRANSFER", "ADJUST"
  referenceType   String?  // "PO", "DELIVERY_ORDER", "TRANSFER", "OPNAME", "MANUAL"
  referenceId     Int?     // ID dari tabel referensi (jika ada)
  createdByUserId Int
  timestamp       DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id])

  transactionItems TransactionItem[]
}

model TransactionItem {
  id            Int @id @default(autoincrement())
  transactionId Int
  productId     Int
  warehouseId   Int
  qtyChange     Int // Pakai plus (+) untuk IN, minus (-) untuk OUT

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
}

// -------------------------------------------------
// 7. Dual-Track Telemetry (UDP Log Aggregator)
// -------------------------------------------------
model TelemetryLog {
  id         Int      @id @default(autoincrement())
  seqId      Int
  level      String   @default("INFO")
  method     String?
  endpoint   String?
  statusCode Int?
  latencyMs  Float?
  userId     Int?
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([endpoint])
  @@index([seqId])
}