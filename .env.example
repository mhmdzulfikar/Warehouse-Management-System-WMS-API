# ==============================================================================
# Environment Configuration - WMS & Telemetry Ecosystem
# ==============================================================================

# Database Connection (PostgreSQL)
# For Local Host Development:
DATABASE_URL="postgresql://postgres:admin1@localhost:5432/wms_db?schema=public"
# For Docker Compose (Internal Network):
# DATABASE_URL="postgresql://postgres:admin1@postgres:5432/wms_db?schema=public"

# HTTP API & Web Dashboard Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here_change_in_production"
JWT_EXPIRES_IN="1d"

# Dual-Track Telemetry (UDP Log Dispatcher)
# For Local Host Development:
UDP_HOST=127.0.0.1
# For Docker Compose (Internal Network):
# UDP_HOST=udp-aggregator
UDP_PORT=5001

# Docker Host Port Mapping (if 5432 is already bound by host PostgreSQL)
POSTGRES_PORT=5432

# Container Automation
AUTO_MIGRATE=true
AUTO_SEED=true
